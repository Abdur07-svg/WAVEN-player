# WAVEN Music Player — Environment Configuration Template
# Copy this file to '.env' for local builds. NEVER commit real secrets to Git!

# Android Release Signing Keystore Configuration
# Set your keystore password below or via GitHub Repository Secrets (WAVEN_KEYSTORE_PASSWORD)
WAVEN_KEYSTORE_PATH=android-mobile/.keystore/waven_release.keystore
WAVEN_KEYSTORE_PASSWORD=your_secure_keystore_password_here
WAVEN_KEY_ALIAS=waven_music

# Optional: Custom output directory for the final APK (defaults to 'dist')
# WAVEN_OUTPUT_DIR=dist

# Optional: Online API & Streaming Configurations
MUSIC_API_KEY=
MUSIC_API_BASE_URL=https://api.audius.co
NEXT_PUBLIC_APP_URL=http://localhost:3000
