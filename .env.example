# AR7 Music Platform Environment Configuration Example
# Keep server-side API secrets protected in production environments

MUSIC_API_KEY=
MUSIC_API_BASE_URL=https://api.audius.co
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional OAuth credentials for registered provider applications
MUSIC_CLIENT_ID=
MUSIC_CLIENT_SECRET=

# Database & Cache Configurations (PostgreSQL / Redis)
DATABASE_URL=postgresql://user:password@localhost:5432/ar7_music
REDIS_URL=redis://localhost:6379
